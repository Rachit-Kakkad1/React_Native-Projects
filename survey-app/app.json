{
  "expo": {
    "name": "survey-app",
    "slug": "survey-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "surveyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow survey-app to access your camera for capturing site photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow survey-app to save site inspection photos to your library.",
          "savePhotosPermission": "Allow survey-app to save site inspection photos to your library."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow survey-app to access your location to pin site surveys.",
          "locationWhenInUsePermission": "Allow survey-app to access your location to pin site surveys."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow survey-app to access your contacts to log site inspection references."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
